# Browser/static site configuration
# Get your Last.fm API key at: https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=your_api_key_here
VITE_LASTFM_USERNAME=your_lastfm_username
VITE_GITHUB_USERNAME=System-End

# Optional: use a separate API origin in built frontend assets.
# Leave this blank for the self-hosted static nginx setup.
VITE_API_BASE_URL=
VITE_USE_LOCAL_API=false

# Local worker dev configuration
# Put real values in .dev.vars or an uncommitted .env, not in git.
LASTFM_API_KEY=your_api_key_here
LASTFM_USERNAME=your_lastfm_username
GITHUB_USERNAME=System-End
