{
  "name": "personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "build": "tsc && vite build",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit",
    "type-check": "tsc --noEmit",
    "dev": "sh -c 'trap \"kill 0\" EXIT; pnpm dev:api & VITE_USE_LOCAL_API=true vite --host 0.0.0.0'",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "clean": "rimraf dist node_modules/.cache",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "itty-router": "^5.0.24",
    "lucide-react": "1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "10.0.1",
    "@rolldown/pluginutils": "1.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "25.9.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "baseline-browser-mapping": "2.11.20",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "husky": "^9.0.10",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-babel": "1.7.3",
    "vitest": "4.1.10",
    "web-vitals": "5.3.0",
    "wrangler": "^4.127.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "workerd"
    ]
  }
}
